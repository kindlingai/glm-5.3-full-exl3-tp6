# Copy to launch.env, fill in, then: set -a; . ./launch.env; set +a; ./launch.sh   (DRY_RUN=0 to actually start)
IMAGE=glm53-exl3-tp6:local          # built with image/tp6 (see README.md, "Reproduce", step 1)
MODEL_DIR=/path/to/GLM-5.3-EXL3-TP6-rank${RANK}   # this rank's export from runtime/tp6-fragments/export_rank.py
GPTQ_DIR=/path/to/gptq-g32/r${RANK} # this rank's 78 solved layer-LLL.safetensors (gptq/README.md)
CACHE_DIR=/path/to/cache            # persistent compile/JIT cache, bind-mounted at /root/.cache in the container
RANK=0                              # 0 = head, 1..5 = worker1..worker5; start workers first
HEAD_ADDR=HEAD_FABRIC_ADDR          # head's address on the RoCE fabric
HOST_ADDR=THIS_NODE_FABRIC_ADDR     # this node's address on the RoCE fabric
NET_IFACE=FABRIC_NETDEV             # netdev carrying HOST_ADDR (NCCL/Gloo socket interface)
IB_HCA=HCA0,HCA1                    # both RoCE HCAs of this node's cabled port (NCCL_IB_MERGE_NICS=1)
# optional: NAME=glm53-tp6  FASTLOAD=0 (stock loader)  ATOMIC=0 (Marlin atomic-add off)
#           D13=1 (adaptive, phase-aware MTP draft length; off by default, see README.md)
DRY_RUN=1
